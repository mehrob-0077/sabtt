# Generate a unique production value with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=example.com,www.example.com
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
SITE_URL=https://example.com
TIME_ZONE=Asia/Dushanbe

# PostgreSQL (create the database and user on the server first)
DB_ENGINE=postgresql
DB_NAME=sabt
DB_USER=sabt
DB_PASSWORD=replace-with-a-strong-database-password
DB_HOST=127.0.0.1
DB_PORT=5432

# SMTP settings, needed for email confirmation
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-address@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-address@gmail.com

# Optional persistent uploads and email API for Render
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# RESEND_API_KEY=re_your_api_key
# DEFAULT_FROM_EMAIL=Sabt <noreply@your-verified-domain.com>

# Enable after HTTPS is configured at the reverse proxy
SECURE_SSL_REDIRECT=True
